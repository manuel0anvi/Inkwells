/* ══════════════════════════════════════════════════════════════════════
   FIRESTORE-SICHERHEITSREGELN  ―  Community-Forum, Freigaben, Adminbereich

   Einspielen: Firebase Console → Firestore Database → Regeln → Inhalt
   dieser Datei einfügen → Veröffentlichen.

   ── Was gegenüber der ersten Fassung dazugekommen ist ───────────────
   Die ursprünglichen Regeln lauteten sinngemäß `allow read, create: if true`.
   Lesen und Schreiben ohne Anmeldung ist für ein offenes Forum richtig so —
   ungeprüft schreiben zu dürfen aber nicht: ohne Prüfung darf jeder
   beliebige Felder anlegen und Dokumente bis 1 MiB ablegen, beliebig oft.
   Das ist bei einem öffentlich erreichbaren Projekt vor allem ein
   Kostenrisiko.

   Deshalb prüfen die Regeln unten zusätzlich:
     · es dürfen NUR die vorgesehenen Felder vorkommen (hasOnly),
     · jedes Feld hat den richtigen Typ,
     · Titel/Text/Name halten dieselben Längen ein wie die Formulare,
     · created_at muss der Server-Zeitstempel sein (serverTimestamp()),
       damit niemand ein Datum frei erfinden kann.

   ── Neu: der Adminbereich ──────────────────────────────────────────
   Früher galt „nur anhängen": Ändern und Löschen war für alle gesperrt,
   Beiträge musste die Betreuung von Hand in der Console entfernen. Das
   übernimmt jetzt der Adminbereich der Website (/admin/).

   Damit das nicht zur Hintertür wird, hängt alles an einer einzigen
   Bedingung: der UID des Adminkontos, siehe adminUid() weiter unten.
   Die Website selbst entscheidet gar nichts – sie zeigt nur Knöpfe an.
   Wer sie im Browser nachbaut, bekommt hier ein „permission-denied".

   Dazugekommen sind:
     · Löschen von Beiträgen und Antworten, nur für das Adminkonto,
     · geschützte Anzeigenamen: niemand außer dem Admin darf unter
       „Inkwells Team" o. Ä. schreiben (isReservedName),
     · site_content: die auf der Website bearbeitete Fassung der
       Datenschutzerklärung. Öffentlich lesbar, nur vom Admin schreibbar.

   ── Einrichtung des Adminkontos ────────────────────────────────────
   1) Console → Authentication → Sign-in method → „E-Mail/Passwort"
      aktivieren (nur die obere Option, nicht „E-Mail-Link").
   2) Authentication → Users → „Add user": E-Mail und Startpasswort.
      Dieselbe Adresse muss in js/config.js unter ADMIN_EMAIL stehen.
   3) Die „User UID" aus der Nutzerliste unten bei adminUid() eintragen.

   Die UID ist kein Geheimnis – wer sie kennt, kann damit nichts anfangen,
   weil das Anmelden weiterhin das Passwort verlangt. Das Passwort steht
   nirgends im Code; es liegt bei Firebase und wird über die Adminseite
   geändert.

   ── Was Regeln NICHT können ────────────────────────────────────────
   Sie kennen keine Rate-Begrenzung. Gegen automatisierte Massenbeiträge
   hilft nur Firebase App Check (Console → App Check → reCAPTCHA v3 für die
   Web-App). Solange das nicht aktiv ist, lohnt ein Blick auf das
   Nutzungs-Budget unter Firebase → Einstellungen → Nutzung und Abrechnung.
   ══════════════════════════════════════════════════════════════════════ */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Name oder Pseudonym; "Gast"/"Anonym" sind normale Namen.
    // Länge wie maxlength im Formular (60).
    function validAuthor(value) {
      return value is string && value.size() > 0 && value.size() <= 60;
    }

    // Freitext mit Ober- und Untergrenze
    function validText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // Muss über serverTimestamp() gesetzt worden sein
    function isServerTime(value) {
      return value == request.time;
    }

    /* ── Das Adminkonto ───────────────────────────────────────────────
       Ein einziges Konto, angemeldet über E-Mail und Passwort. Erkannt
       wird es an der UID, nicht an der Adresse: Adressen lassen sich bei
       manchen Anbietern ändern, die UID nie. Außerdem ist mit „E-Mail/
       Passwort" das Anlegen eigener Konten vom Browser aus grundsätzlich
       möglich – ein neu erfundenes Konto trifft die UID unten aber nicht,
       und genau darauf kommt es an.

       Die UID steht in der Console → Authentication → Users, Spalte
       „User UID". Sie ist kein Geheimnis – wer sie kennt, kann damit
       nichts anfangen, weil das Anmelden weiterhin das Passwort verlangt.
       ───────────────────────────────────────────────────────────────── */
    function adminUid() {
      return '9czynXNXAlfs8bGtx5hEOO9dRCd2';
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid == adminUid();
    }

    /* ── Geschützte Anzeigenamen ──────────────────────────────────────
       Ohne diese Sperre könnte sich jeder „Inkwells Team" nennen und im
       Namen des Projekts antworten. Für Leser wäre das nicht zu
       unterscheiden – und genau deshalb gehört die Prüfung hierher und
       nicht nur ins Formular.

       Verglichen wird eine vereinfachte Fassung des Namens: klein
       geschrieben und ohne alles, was kein Buchstabe und keine Ziffer
       ist. Dadurch fallen „Ink-well", „I.n.k.w.e.l.l" und „I n k w e l l"
       mit „inkwell" zusammen.

       matches() vergleicht immer die GANZE Zeichenkette, deshalb die
       Punkte außen herum – sonst müsste der Name exakt „inkwell" lauten.

       >>> Warum hier „inkwell" steht und nicht „inkwells" <<<
       Die App heißt inzwischen Inkwells. Die Sperre trägt trotzdem die
       KURZE Form: sie wird als Teilzeichenfolge gesucht, und „inkwell"
       fängt „inkwells" damit mit ab. Andersherum nicht – wer hier auf
       „inkwells" umstellt, gibt den Namen „Inkwell Team" wieder frei.

       Die Ziffernschreibweisen stehen einzeln in der Liste. Die Website
       übersetzt sie vorher zurück (normalizeAuthorName in js/config.js)
       und fängt dadurch mehr Fälle ab; hier steht die Grundsicherung für
       den Fall, dass jemand das Formular umgeht. ─────────────────── */
    function normalizedName(name) {
      return name.lower().replace('[^a-z0-9]', '');
    }

    function isReservedName(name) {
      return normalizedName(name).matches(
        '.*(inkwell|1nkwell|inkwe11|admin|4dmin|administrator|moderator|m0derator|support|supp0rt|offiziell|official|0fficial|anvi|4nvi).*'
      );
    }

    match /community_posts/{postId} {
      allow read: if true;

      /* Anlegen darf jeder – aber niemand unter einem geschützten Namen.
         Der Admin ist ausgenommen, sonst könnte ausgerechnet er nicht als
         „Inkwells Team" antworten. */
      allow create: if request.resource.data.keys()
                          .hasOnly(['type', 'title', 'author', 'content', 'created_at'])
                    && request.resource.data.type in ['question', 'bug']
                    && validText(request.resource.data.title, 120)
                    && validAuthor(request.resource.data.author)
                    && validText(request.resource.data.content, 2000)
                    && isServerTime(request.resource.data.created_at)
                    && (isAdmin() || !isReservedName(request.resource.data.author));

      /* Ändern bleibt für alle gesperrt: ein nachträglich umgeschriebener
         Beitrag wäre für Leser nicht erkennbar. Löschen darf nur der
         Admin – das ist die Moderation. */
      allow update: if false;
      allow delete: if isAdmin();

      match /replies/{replyId} {
        allow read: if true;

        allow create: if request.resource.data.keys()
                            .hasOnly(['author', 'content', 'created_at'])
                      && validAuthor(request.resource.data.author)
                      && validText(request.resource.data.content, 500)
                      && isServerTime(request.resource.data.created_at)
                      && (isAdmin() || !isReservedName(request.resource.data.author));

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    /* ── Seiteninhalte ────────────────────────────────────────────────
       Zurzeit ein einziges Dokument: site_content/privacy, die über die
       Adminseite bearbeitete Datenschutzerklärung.

       Lesen muss jeder dürfen, auch ohne Anmeldung – sonst sähe niemand
       die Erklärung. Der feste Text in js/privacy-content.js bleibt der
       Rückfall, falls hier nichts steht.
       ───────────────────────────────────────────────────────────────── */
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ── Postfach: was jeder schon gelesen und geloescht hat ──────────
       Die Nachrichten SELBST stehen in site_content/nachrichten und sind
       oeffentlich lesbar – der Empfaengerkreis ist eine Hoeflichkeit der
       App, keine Sperre (siehe src/core/postfach.js). Hier steht nur der
       persoenliche Stand: welche Kennungen gelesen, welche geloescht.

       Jeder sieht und schreibt ausschliesslich sein eigenes Dokument.
       Auch die anonyme Geraetekennung zaehlt – ohne sie haetten Nutzer
       ohne Konto gar kein Postfach.

       Geschrieben wird immer der ganze Stand, nicht nur das Neue: beide
       Listen wachsen nur, der Abgleich zwischen zwei Rechnern ist
       deshalb eine Vereinigung und braucht keine Reihenfolge.

       Der Admin bekommt hier bewusst KEINEN Zugriff. Er verschickt
       Nachrichten, er liest nicht mit, wer sie geoeffnet hat.
       ───────────────────────────────────────────────────────────────── */
    match /postfach/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    /* ── Kennung des Anmeldenden ──────────────────────────────────────
       Seit die App das id_token von Google bzw. Microsoft an Firebase
       weiterreicht (js/share.js, signInWithProviderToken), steht hier
       eine echte, vom Anbieter bestätigte Adresse. Ohne Anmeldung oder
       bei einer rein anonymen Gerätekennung ist sie leer.

       Kleinschreibung überall: die Oberfläche legt Adressen ebenfalls
       klein ab, sonst greift array-contains nicht. ────────────────── */
    function myEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    /* Ist die Adresse vertrauenswürdig?

       Google setzt email_verified zuverlässig. Microsoft tut das NICHT
       immer – bei persönlichen Konten fehlt die Angabe oder steht auf
       false, obwohl die Adresse dem Konto gehört. Würde hier stur auf
       email_verified bestanden, könnte sich mit Microsoft niemand etwas
       teilen lassen.

       Deshalb: entweder ausdrücklich bestätigt, oder die Anmeldung kam
       über einen der beiden Anbieter, die wir selbst eingerichtet haben.
       Eine anonyme Gerätekennung fällt dadurch weiterhin durch.

       Das Adminkonto meldet sich mit Passwort an und fällt hier ebenfalls
       durch – das ist beabsichtigt. Es hat mit dem Teilen von Heften
       nichts zu tun und braucht diese Rechte nicht. */
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email != null
        && (
             request.auth.token.email_verified == true
             || request.auth.token.firebase.sign_in_provider in ['google.com', 'microsoft.com']
           );
    }

    /* ══════════════════════════════════════════════════════════════════
       SPERREN

       Eine Sperre steht unter ihrer eigenen Adresse: sperren/{email}.
       Kleingeschrieben, weil myEmail() das auch tut – sonst fände die
       Regel unten nichts.

       >>> Warum die Adresse als Dokumentname und nicht die UID <<<
       Weil die Verwaltung die UID nicht kennt. Gemeldet wird jemand über
       die Anwesenheitsliste eines Dokuments, und dort steht die Adresse.
       Eine Zuordnung Adresse → UID gäbe es nur, wenn wir sie führten –
       und die wäre eine öffentlich lesbare Liste aller Nutzer.

       Lesen darf, wen es angeht: der Betroffene selbst (die App sagt ihm
       dann, warum etwas nicht geht) und die Verwaltung. Schreiben nur die
       Verwaltung. Auflisten darf niemand ausser ihr – sonst stünde hier
       eine Liste aller je gesperrten Adressen.

       Die Sperre WIRKT weiter unten bei /docs. Dort wird sie mit get()
       nachgeschlagen; get() geht an dieser Regel vorbei, das ist so
       vorgesehen.
       ══════════════════════════════════════════════════════════════════ */
    match /sperren/{email} {
      allow get: if isAdmin() || (myEmail() != '' && email == myEmail());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    /* Läuft gegen diese Adresse gerade eine Sperre für DIESE eine Sache?

       Die drei Werte stehen genauso in src/core/melden.js:
         neueFreigaben  kommt in kein geteiltes Dokument mehr hinein
         selbstTeilen   gibt selbst nichts mehr frei
         laufendeRaus   verliert auch die, in denen er schon ist

       Ein fehlendes Enddatum heisst unbegrenzt. Ein Datum in der
       Vergangenheit heisst: vorbei. Aufgeräumt wird nichts – eine
       abgelaufene Sperre schadet nicht, und ein Aufräumdienst wäre eine
       weitere Sache, die stillschweigend kaputtgehen kann.

       >>> Was das kostet <<<
       Ein zusätzlicher Lesevorgang, sobald jemand auf ein fremdes
       Dokument zugreift. exists() steht bewusst davor: für alle, gegen
       die nichts vorliegt – also praktisch alle – bricht die Prüfung dort
       ab, und get() läuft gar nicht erst. */
    function sperrPfad(email) {
      return /databases/$(database)/documents/sperren/$(email);
    }

    function gesperrtFuer(was) {
      return myEmail() != ''
             && exists(sperrPfad(myEmail()))
             && get(sperrPfad(myEmail())).data.get('umfang', {}).get(was, false) == true
             && (
                  get(sperrPfad(myEmail())).data.get('bis', null) == null
                  || get(sperrPfad(myEmail())).data.bis > request.time
                );
    }

    /* ══════════════════════════════════════════════════════════════════
       MELDUNGEN

       Wer in einem geteilten Dokument sitzt, kann jemanden melden. Die
       Meldung geht an zwei Stellen: an den Besitzer des Dokuments, der
       die Freigabe zurücknehmen kann, und an die Verwaltung.

       >>> Was NICHT darin steht <<<
       Keine Chatzeilen, keine Seiteninhalte. Nur ein Grund aus einer
       festen Liste und höchstens zwei Sätze dazu. Die Liste steht hier
       noch einmal, damit auch am Formular vorbei nichts anderes
       ankommt.

       >>> Warum die Adresse des Meldenden mit hinein muss <<<
       Damit sich derselbe nicht hundertmal melden lässt und damit die
       Verwaltung sieht, wenn jemand das Melden selbst missbraucht. Der
       Gemeldete bekommt sie NICHT zu sehen – er sieht die Meldung
       überhaupt nicht.

       Geändert werden darf nur `erledigt`, und nur von der Verwaltung
       oder dem Besitzer. Der Rest der Meldung steht fest: was einmal
       gemeldet wurde, soll niemand nachträglich umschreiben.
       ══════════════════════════════════════════════════════════════════ */
    function validGrund(g) {
      return g in ['beleidigung', 'werbung', 'fremdeInhalte', 'zerstoerung', 'sonstiges'];
    }

    match /meldungen/{meldungId} {
      function m() { return resource.data; }

      /* ══════════════════════════════════════════════════════════════
         WIRD DER BESITZER SELBST GEMELDET, SIEHT ER ES NICHT

         Sonst bekaeme er die Beschwerde ueber sich vorgelegt, koennte
         sie abhaken – und angeboten wuerde ihm ausgerechnet, sich aus
         seinem eigenen Dokument zu verbannen. Dann meldet ihn niemand
         mehr, und das Melden waere gegen den, der am meisten anrichten
         kann, wertlos.

         Solche Meldungen gehen nur an die Verwaltung.

         get(…, false): Meldungen aus der Zeit vor diesem Feld haben es
         nicht, und ein Zugriff auf einen fehlenden Schluessel laesst die
         ganze Regel in einen Fehler laufen – sie wuerde dann auch das
         Erlaubte abweisen. Ohne Angabe gilt: nicht gegen den Besitzer.
         ══════════════════════════════════════════════════════════════ */
      allow get, list: if isAdmin()
                       || (request.auth != null
                           && m().ownerUid == request.auth.uid
                           && m().get('gegenBesitzer', false) == false);

      allow create: if isVerifiedUser()
                    && request.resource.data.melderEmail == myEmail()
                    && request.resource.data.gemeldetEmail is string
                    && request.resource.data.gemeldetEmail.size() > 0
                    && request.resource.data.gemeldetEmail != myEmail()
                    && validGrund(request.resource.data.grund)
                    && request.resource.data.docId is string
                    && request.resource.data.docId.size() > 0
                    && request.resource.data.ownerUid is string
                    /* Der Vermerk muss stimmen: sonst koennte ein Melder
                       ihn auf true setzen und damit JEDE Meldung am
                       Besitzer vorbeischleusen – oder auf false, und der
                       Besitzer bekaeme die Beschwerde ueber sich selbst
                       doch zu sehen. Nachgeschlagen wird im Kopf des
                       Dokuments; das kostet einen Lesevorgang, aber nur
                       beim Melden, und das geschieht selten. */
                    && request.resource.data.gegenBesitzer ==
                         (request.resource.data.gemeldetEmail ==
                          get(/databases/$(database)/documents/docs/$(request.resource.data.docId))
                            .data.ownerEmail.lower())
                    && request.resource.data.notiz is string
                    && request.resource.data.notiz.size() <= 300
                    && request.resource.data.erledigt == false
                    && isServerTime(request.resource.data.erstellt);

      /* Dieselbe Ausnahme wie beim Lesen: eine Meldung ueber den
         Besitzer darf er auch nicht abhaken. Lesen konnte er sie schon
         nicht – abhaken aber schon, und dazu braucht es nur die Kennung.
         Gefunden hat das scripts/test-rules.js. */
      allow update: if (isAdmin()
                        || (request.auth != null
                            && m().ownerUid == request.auth.uid
                            && m().get('gegenBesitzer', false) == false))
                    /* `massnahme` haelt fest, WIE der Besitzer entschieden
                       hat: verbannt oder für harmlos befunden. Ohne das
                       staende in der Verwaltung nur „erledigt". */
                    && request.resource.data.diff(m()).affectedKeys()
                         .hasOnly(['erledigt', 'massnahme'])
                    && (!('massnahme' in request.resource.data)
                        || request.resource.data.massnahme in ['verbannt', 'nichts']);

      allow delete: if isAdmin();
    }

    /* ══════════════════════════════════════════════════════════════════
       DIREKTPOST — eine Nachricht an EINEN Nutzer

       Die gewöhnlichen Postfach-Nachrichten stehen in site_content und
       sind öffentlich lesbar; der Empfängerkreis ist dort eine
       Höflichkeit der App, keine Sperre (src/core/postfach.js).

       Für „du wurdest gemeldet" reicht das nicht. So eine Nachricht
       nennt einen Vorwurf, und sie hat niemanden ausser dem Empfänger
       etwas anzugehen. Deshalb ein eigenes Dokument je Adresse, das nur
       er und die Verwaltung lesen dürfen.

       Aufbau wie in site_content/nachrichten: ein Feld `liste` mit
       denselben Nachrichten-Objekten. Dadurch kann das Postfach in der
       App beide Quellen einfach hintereinanderhängen (ui/postfach.js).
       ══════════════════════════════════════════════════════════════════ */
    match /direktpost/{email} {
      allow get: if isAdmin() || (myEmail() != '' && email == myEmail());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    /* ── Freigegebene Hefte ───────────────────────────────────────────
       Lesen darf jeder, der den Link kennt – das ist der Zweck. Die
       Kennung im Link ist 22 Zeichen lang und zufällig, also nicht
       erratbar. Eine Liste aller Freigaben gibt es nicht: ohne die
       Kennung kommt man an nichts heran (Firestore erlaubt kein
       Auflisten, wenn die Regel den Dokumentnamen nicht kennt).

       Anlegen darf jedes anonym angemeldete Gerät, aber nur mit sich
       selbst als Besitzer. Ändern und Löschen darf ausschließlich der
       eingetragene Besitzer.
       ───────────────────────────────────────────────────────────────── */
    match /shared_notebooks/{shareId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.mode in ['frozen', 'live']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.chunkCount is int
                    && request.resource.data.chunkCount > 0
                    && request.resource.data.chunkCount <= 500;

      /* Ändern darf der eingetragene Besitzer – oder wer nachweislich zu
         der hinterlegten E-Mail-Adresse gehört. Der zweite Fall ist der
         Umstieg von der Gerätekennung auf das Konto: Freigaben, die früher
         einer anonymen Kennung gehörten, lassen sich dadurch von jedem
         Gerät aus übernehmen und später auch wieder aufheben.
         Der Besitzer kann dabei nur auf einen selbst umgeschrieben werden. */
      allow update: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && (
                         resource.data.owner == request.auth.uid
                         || (
                              isVerifiedUser()
                              && 'ownerEmail' in resource.data
                              && resource.data.ownerEmail.lower() == myEmail()
                            )
                       );

      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;

      match /chunks/{index} {
        allow read: if true;

        // Schreiben nur, wenn das Kopf-Dokument diesem Gerät gehört.
        // Der Kopf wird immer ZUERST geschrieben (siehe js/share.js),
        // deshalb steht der Besitzer hier schon fest – es braucht keinen
        // Sonderfall für das erste Anlegen.
        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/shared_notebooks/$(shareId)).data.owner == request.auth.uid;
      }
    }

    /* ── Geteilte Dokumente ───────────────────────────────────────────
       Ein Dokument ist ein Heft, das mit bestimmten Leuten geteilt ist.
       Wer dazugehört, steht in memberEmails – daraus besteht der ganze
       Tab „Geteilte Dokumente": eine einzige Abfrage
         where('memberEmails', 'array-contains', meineAdresse)
       Wird jemand daraus entfernt, verschwindet das Dokument bei ihm beim
       nächsten Laden von selbst. Es gibt bewusst keine zweite Liste.

       ── Wer darf lesen ─────────────────────────────────────────────
       · der Besitzer,
       · wer in memberEmails steht,
       · und jeder, der die Dokumentkennung hat, solange ein Link mit
         Leserecht besteht. Das Letzte ist gewollt: der Link soll auch
         ohne Konto funktionieren.

       >>> Grenze, die man kennen muss <<<
       Der Schutz des Links liegt in seiner Kennung (22 zufällige
       Zeichen). In der Adresse steht die LINK-Kennung, nicht die des
       Dokuments; „Link erneuern" löscht den Eintrag unter doc_links und
       die verschickte Adresse läuft ins Leere. Wer sich die interne
       Dokumentkennung aus der Netzwerkansicht herausgesucht hat, käme
       trotzdem noch heran – dagegen hilft nur, den Link ganz abzuschalten
       (linkMode = 'off') oder die Freigabe aufzuheben.
       ───────────────────────────────────────────────────────────────── */
    match /docs/{docId} {

      function head() { return resource.data; }

      function isDocOwner() {
        return request.auth != null && head().owner == request.auth.uid;
      }

      /* Wer aus laufenden Freigaben geworfen wurde, ist hier kein
         Mitglied mehr – ohne dass ihn jemand aus der Liste streichen
         müsste. Das ist der Punkt: die Verwaltung kennt die Dokumente
         des Gesperrten gar nicht (eine Liste aller Dokumente gibt es
         absichtlich nicht), könnte ihn also nirgends austragen. Läuft
         die Sperre ab, ist er wieder dabei, wo er vorher war. */
      function isMember() {
        return myEmail() != '' && myEmail() in head().memberEmails
               && !gesperrtFuer('laufendeRaus');
      }

      function linkIsOpen() {
        return head().linkMode in ['view', 'edit'];
      }

      /* ══════════════════════════════════════════════════════════════
         WER HINAUSGEWORFEN WURDE, KOMMT AUCH UEBER DEN LINK NICHT

         removeMember() traegt die Adresse in blockedEmails ein. Geprueft
         wurde sie bisher nur beim Selbsteintrag (selfJoin) – nicht beim
         LESEN ueber den offenen Link. Der Hinausgeworfene sah das
         Dokument also weiter, er stand nur nicht mehr in der Liste.
         Schreiben konnte er nicht (dafuer braucht es die Mitgliedschaft),
         aber mitlesen schon, und darum ging es dem Besitzer gerade nicht.

         >>> Was das NICHT kann <<<
         Gesperrt wird nach ADRESSE. Wer den Link ohne Konto oeffnet, hat
         keine – fuer den bleibt ein offener Link offen. Das ist die Natur
         eines Links; wer wirklich zumachen will, stellt ihn auf 'off'
         oder wuerfelt ihn neu (rotateLink).
         ══════════════════════════════════════════════════════════════ */
      function rausgeworfen() {
        return myEmail() != '' && myEmail() in head().blockedEmails;
      }

      /* Lesen einzeln: Besitzer, Mitglied oder offener Link.

         `resource == null` steht bewusst vorn: fragt jemand nach einem
         Dokument, das es nicht (mehr) gibt, laufen alle drei Prüfungen in
         einen Fehler – sie greifen auf resource.data zu. Firestore
         antwortet dann mit „keine Berechtigung" statt mit „gibt es
         nicht", und die App zeigt eine Fehlermeldung, wo ein schlichtes
         „Freigabe gibt es nicht mehr" hingehört. Verraten wird dadurch
         nichts: dass etwas NICHT existiert, ist kein Geheimnis. */
      /* Der offene Link steht hinter derselben Sperre wie die
         Mitgliedschaft. Ohne das las der aus laufenden Freigaben
         Geworfene den Kopf einfach ueber den Link weiter, den er ja
         schon hatte – gefunden hat das scripts/test-rules.js.
         Dieselbe Ueberlegung wie bei mayReadContent() weiter unten. */
      allow get: if resource == null
                    || isDocOwner()
                    || isMember()
                    || (linkIsOpen()
                        && !rausgeworfen()
                        && !gesperrtFuer('laufendeRaus')
                        && !gesperrtFuer('neueFreigaben'));

      /* Auflisten nur über die Mitgliedschaft oder den eigenen Besitz –
         eine Liste ALLER Dokumente gibt es dadurch nicht, auch nicht für
         Angemeldete. Firestore prüft diese Regel gegen jedes Dokument im
         Ergebnis; eine Abfrage ohne passende Einschränkung scheitert also
         von selbst.

         Der Besitzerfall kam dazu, damit das Freigabe-Fenster nachsehen
         kann, ob ein Heft schon geteilt ist (findOwnedDocForNotebook in
         share.js). Ohne ihn stand dort „noch nicht freigegeben", sobald
         die Freigabe von einem anderen Gerät oder Browser stammte. */
      allow list: if isMember() || isDocOwner();

      /* Kein chunkCount mehr: der Inhalt liegt seit dem zerlegten Modell
         in pages/ink/blobs, nicht in Stücken. Stattdessen wird die
         Seitenzahl geprüft – die gibt es in beiden Formen. */
      allow create: if isVerifiedUser()
                    && !gesperrtFuer('selbstTeilen')
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.ownerEmail.lower() == myEmail()
                    && request.resource.data.linkMode in ['off', 'view', 'edit']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.pageCount is int
                    && request.resource.data.pageCount >= 0
                    && request.resource.data.pageCount <= 2000
                    && request.resource.data.memberEmails.size() == 0;

      /* Der Besitzer darf alles ändern, nur nicht den Besitz abgeben. */
      function ownerUpdate() {
        return isDocOwner()
               && request.resource.data.owner == request.auth.uid
               && request.resource.data.linkMode in ['off', 'view', 'edit']
               /* Wer nicht teilen darf, darf auch niemanden dazuholen –
                  sonst wäre die Sperre mit zwei Klicks umgangen. Das
                  Wegnehmen bleibt erlaubt, und am eigenen Inhalt ändert
                  sie ohnehin nichts: die Liste darf nur nicht wachsen. */
               && (
                    !gesperrtFuer('selbstTeilen')
                    || (
                         request.resource.data.memberEmails.size()
                           <= head().memberEmails.size()
                         && request.resource.data.linkMode == 'off'
                       )
                  );
      }

      /* Selbsteintrag über den Link: nur die eigene Adresse, nur mit der
         Rolle, die der Link hergibt, und nur wenn man nicht gesperrt ist.
         Ohne die Sperrliste könnte eine entfernte Person den Link einfach
         noch einmal öffnen und wäre sofort wieder dabei. */
      function selfJoin() {
        return isVerifiedUser()
               && linkIsOpen()
               && !(myEmail() in head().blockedEmails)
               // Gesperrt heisst: in kein geteiltes Dokument mehr hinein
               && !gesperrtFuer('neueFreigaben')
               && request.resource.data.diff(head()).affectedKeys()
                    .hasOnly(['memberEmails', 'members', 'memberVia'])
               && myEmail() in request.resource.data.memberEmails
               && request.resource.data.memberEmails.size()
                    <= head().memberEmails.size() + 1
               && request.resource.data.members[myEmail()] == head().linkMode
               // Fremde Einträge müssen unverändert bleiben
               && head().memberEmails.hasOnly(request.resource.data.memberEmails)
               /* Und zwar auch in der Rollentabelle. Ohne diese Zeile
                  durfte man sich zwar nur selbst in memberEmails
                  eintragen, in `members` aber beliebige fremde Adressen
                  anlegen – mit 'edit'. Beim Inhalt fällt das inzwischen
                  auf (mayWriteContent prüft beides), hier wird es gar
                  nicht erst möglich. */
               && request.resource.data.members.diff(head().members)
                    .affectedKeys().hasOnly([myEmail()]);
      }

      /* ── Die eigene Firebase-Kennung eintragen ────────────────────
         Wer dazugehört, steht als ADRESSE in memberEmails. Die Regeln der
         Realtime Database kennen aber nur auth.uid, und der Besitzer muss
         dort eine Rollenliste hinterlegen (website/database.rules.json).
         Dafür braucht er die Zuordnung Kennung → Adresse.

         Jeder trägt deshalb seinen eigenen Eintrag ein, und ZWAR NUR den:
         der Schlüssel muss die eigene uid sein und der Wert die eigene
         Adresse. Wer nicht Mitglied ist, kommt gar nicht erst durch –
         sonst könnte sich jemand über diesen Weg in die Rollenliste
         schreiben lassen. Dasselbe Muster wie beim Selbsteintrag. */
      function selfRegisterUid() {
        return isVerifiedUser()
               && myEmail() in head().memberEmails
               && request.resource.data.diff(head()).affectedKeys()
                    .hasOnly(['memberUids'])
               /* Mit get(…, {}): beim ersten Eintrag gibt es das Feld noch
                  gar nicht, und ein Zugriff auf einen fehlenden Schlüssel
                  lässt die ganze Regel in einen Fehler laufen – sie würde
                  dann ausgerechnet den erlaubten Fall abweisen. */
               && request.resource.data.get('memberUids', {})
                    .diff(head().get('memberUids', {}))
                    .affectedKeys().hasOnly([request.auth.uid])
               && request.resource.data.get('memberUids', {})[request.auth.uid] == myEmail();
      }

      /* Wer Bearbeitungsrecht hat, darf den Inhalt neu schreiben – am Kopf
         aber nur die Angaben, die dazugehören. Titel, Rechte und die
         Mitgliederliste bleiben Sache des Besitzers. */
      function canEdit() {
        return myEmail() != ''
               && myEmail() in head().memberEmails
               && head().members[myEmail()] == 'edit';
      }

      /* Seit der Inhalt in einzelne Seiten zerlegt ist, schreibt niemand
         mehr das ganze Heft. Am Kopf bleiben für Bearbeiter nur die
         Angaben, die zum Inhalt gehören: Reihenfolge, Abschnitte, Stand.
         Titel, Rechte und Mitgliederliste bleiben Sache des Besitzers.

         `roomKey` steht bewusst NICHT in der Liste. Er sagt, unter
         welchem Namen der Live-Raum in der Realtime Database läuft, und
         der Besitzer wechselt ihn, wenn jemand seinen Raum besetzt hat
         (joinDocRoom in core/share.js, ausführlich in
         website/database.rules.json). Dürfte ein Bearbeiter ihn ändern,
         könnte er alle anderen aus dem Raum aussperren – und der
         Besitzer müsste jedes Mal hinterherwechseln. */
      function editorUpdate() {
        return isVerifiedUser()
               && canEdit()
               && request.resource.data.diff(head()).affectedKeys()
                    .hasOnly([
                      'pageOrder', 'pageCount', 'sections', 'activeSecId',
                      'chunkCount', 'revision', 'updatedAt'
                    ])
               // Nur vorwärts. Die Nummer ist kein Schloss mehr, sondern ein
               // Zähler, an dem die anderen Clients Neues erkennen.
               && request.resource.data.revision > head().revision;
      }

      /* Selbst aussteigen: nur die eigene Adresse darf verschwinden.
         Für Empfänger ist das die Entsprechung zu „Löschen" – das fremde
         Heft selbst geht sie nichts an. */
      function selfLeave() {
        return request.auth != null
               && myEmail() != ''
               && myEmail() in head().memberEmails
               && request.resource.data.diff(head()).affectedKeys()
                    .hasOnly(['memberEmails', 'members', 'memberVia'])
               && !(myEmail() in request.resource.data.memberEmails)
               && request.resource.data.memberEmails.size()
                    == head().memberEmails.size() - 1
               && request.resource.data.memberEmails
                    .hasOnly(head().memberEmails)
               // Beim Hinausgehen wird auch in der Rollentabelle nur der
               // eigene Eintrag angefasst.
               && request.resource.data.members.diff(head().members)
                    .affectedKeys().hasOnly([myEmail()]);
      }

      allow update: if ownerUpdate() || editorUpdate() || selfJoin() || selfLeave()
                    || selfRegisterUid();

      allow delete: if isDocOwner();

      /* ── Der Inhalt ────────────────────────────────────────────────
         Vier Unterordner mit denselben Rechten:

           pages   eine Seite = ein Dokument
           ink     Handschrift, bogenweise (arrayUnion beim Anhängen)
           blobs   Bilder und PDF-Seiten, gestückelt
           chunks  die alte Klumpenform, nur noch zum Lesen und Aufräumen

         Gelesen wird wie beim Kopf. Dafür muss die Regel den Kopf
         nachschlagen, weil resource hier der Inhalt ist – das ist ein
         zusätzlicher Lesevorgang je Anfrage, aber der einzige Weg.
         Schreiben darf der Besitzer und wer Bearbeitungsrecht hat.

         Warum die Rechte NICHT je Unterordner unterschiedlich sind:
         Wer eine Seite ändern darf, muss auch ihre Handschrift und ihre
         Bilder ändern dürfen. Eine feinere Aufteilung würde nur mehr
         Nachschlagevorgänge kosten, ohne etwas zu schützen.
         ──────────────────────────────────────────────────────────── */
      function docHead() {
        return get(/databases/$(database)/documents/docs/$(docId)).data;
      }

      /* request.auth kann null sein – ein Link darf ja ohne Konto
         geöffnet werden. Ohne die Prüfung darauf liefe request.auth.uid
         in einen Fehler und die Regel würde ALLES ablehnen, auch das
         erlaubte Lesen über den Link. */
      function mayReadContent() {
        return (request.auth != null && docHead().owner == request.auth.uid)
               || (myEmail() != '' && myEmail() in docHead().memberEmails
                   && !gesperrtFuer('laufendeRaus'))
               /* Der offene Link steht bewusst hinter derselben Sperre:
                  sonst käme der Hinausgeworfene über den Link, den er ja
                  schon hat, sofort wieder herein – nur ohne Namen. */
               /* Und wer aus DIESEM Dokument hinausgeworfen wurde,
                  liest es auch ueber den Link nicht weiter – siehe
                  rausgeworfen() beim Kopf. */
               || (docHead().linkMode in ['view', 'edit']
                   && !(myEmail() != '' && myEmail() in docHead().blockedEmails)
                   && !gesperrtFuer('laufendeRaus')
                   && !gesperrtFuer('neueFreigaben'));
      }

      /* >>> Die Mitgliederliste MUSS mitgeprüft werden <<<
         Vorher stand hier nur `members[meineAdresse] == 'edit'`. Das war
         eine Lücke, und zwar eine, die sich ausnutzen ließ: der
         Selbsteintrag über den Link (selfJoin, oben) darf `members`
         anfassen. Er stellt sicher, dass die EIGENE Rolle nicht höher
         wird als der Link hergibt – aber niemand hinderte einen daran,
         im selben Zug einen Eintrag für eine ANDERE Adresse anzulegen.
         Diese Adresse stand dann in `members` mit 'edit', ohne je in
         memberEmails zu stehen, und kam hier durch.

         Mit der zusätzlichen Prüfung läuft ein solcher Eintrag ins Leere:
         in memberEmails kommt man nur über den Besitzer oder über den
         Selbsteintrag, und der trägt ausschließlich die eigene Adresse
         ein. Gefunden hat das scripts/test-rules.js. */
      function mayWriteContent() {
        return request.auth != null
               && (
                    docHead().owner == request.auth.uid
                    || (
                         myEmail() != ''
                         && myEmail() in docHead().memberEmails
                         && docHead().members[myEmail()] == 'edit'
                         && !gesperrtFuer('laufendeRaus')
                       )
                  );
      }

      match /pages/{pageId} {
        allow read: if mayReadContent();
        allow write: if mayWriteContent();
      }

      match /ink/{sheetId} {
        allow read: if mayReadContent();
        allow write: if mayWriteContent();
      }

      match /blobs/{blobKey} {
        allow read: if mayReadContent();
        allow write: if mayWriteContent();
      }

      match /chunks/{index} {
        allow read: if mayReadContent();
        allow write: if mayWriteContent();
      }
    }

    /* ── Nachschlagewerk Link -> Dokument ─────────────────────────────
       Öffentlich lesbar, das ist der Zweck: die Adresse trägt nur die
       Link-Kennung, erst hierüber wird daraus ein Dokument. Anlegen und
       löschen darf nur, wer sich selbst als Besitzer einträgt – die
       Dokumentregeln prüfen danach ohnehin noch einmal alles.

       >>> Warum Anlegen und Ändern getrennt stehen <<<
       Vorher galt für beides dieselbe Bedingung, und die sah nur die NEUE
       Fassung an. Wer eine fremde Link-Kennung kannte, konnte den Eintrag
       also überschreiben und auf sein eigenes Dokument umbiegen: der Link,
       den jemand anderes verschickt hatte, führte danach woandershin.
       Ändern darf jetzt nur, wem der Eintrag schon gehört.
       ───────────────────────────────────────────────────────────────── */
    match /doc_links/{linkId} {
      allow get: if true;
      allow list: if false;

      function validLink() {
        return isVerifiedUser()
               && request.resource.data.owner == request.auth.uid
               && request.resource.data.docId is string
               && request.resource.data.docId.size() > 0;
      }

      allow create: if validLink();

      allow update: if validLink()
                    && resource.data.owner == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;
    }

    // Alles andere im Projekt bleibt zu.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
