
{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      "$docId": {
        ".read": "auth != null",

        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['uid', 'initials', 'name', 'color'])",

          "uid":      { ".validate": "newData.val() === $uid" },
          "initials": { ".validate": "newData.isString() && newData.val().length <= 4" },
          "name":     { ".validate": "newData.isString() && newData.val().length <= 120" },
          "email":    { ".validate": "newData.isString() && newData.val().length <= 200" },
          "color":    { ".validate": "newData.isString() && newData.val().length <= 32" },
          "pageId":   { ".validate": "newData.isString() && newData.val().length <= 64" },
          "offset":   { ".validate": "newData.isNumber()" },

          "lockFrom": { ".validate": "newData.isNumber()" },
          "lockTo":   { ".validate": "newData.isNumber()" },
          "lockAt":   { ".validate": "newData.isNumber()" },
          "cx":       { ".validate": "newData.isString() && newData.val().length <= 64" },

          "at":       { ".validate": "newData.isNumber()" },

          "lost":     { ".validate": "newData.isNumber()" },

          "$other":   { ".validate": false }
        }
      }
    },

    "ops": {
      "$docId": {
        ".read": "auth != null",

        "$opId": {
          ".write": "auth != null && (!data.exists() || data.child('by').val() === auth.uid || (!newData.exists() && data.child('at').isNumber() && data.child('at').val() < now - 600000))",

          ".validate": "newData.hasChildren(['k', 'p', 'by', 'at'])",

          "k":  { ".validate": "newData.isString() && newData.val().length <= 8" },
          "p":  { ".validate": "newData.isString() && newData.val().length <= 64" },
          "by": { ".validate": "newData.val() === auth.uid" },
          "at": { ".validate": "newData.isNumber()" },
          "u":  { ".validate": "newData.isString() && newData.val().length <= 200000" },
          "s":  { ".validate": "newData.hasChildren()" },

          "c":  { ".validate": "newData.isNumber()" },
          "lf": { ".validate": "newData.isNumber()" },
          "lt": { ".validate": "newData.isNumber()" },
          "cx": { ".validate": "newData.isString() && newData.val().length <= 64" },

          "$other": { ".validate": false }
        }
      }
    }
  }
}
