{
  "name": "inkwell",
  "version": "1.1.1",
  "description": "Inkwell - Digital Notebook",
  "author": "Manuel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve-website.js",
    "test": "node scripts/test-doc-split.js && node scripts/test-ink-diff.js && node scripts/test-page-transfer.js && node scripts/test-account-switch.js && node scripts/test-collab-text.js && node scripts/test-collab-caret.js && node scripts/test-collab-sync.js && node scripts/test-shared-save.js && node scripts/test-cloud-match.js && node scripts/test-cloud-flush.js && node scripts/test-csp-rtdb.js && node scripts/test-cloud-trash-move.js && node scripts/test-trash-sync.js && node scripts/test-view-state.js && node scripts/test-versions.js && node scripts/sync-share.js --check",
    "build": "npm test && node scripts/build-release.js",
    "sync-share": "node scripts/sync-share.js",
    "check-share": "node scripts/sync-share.js --check",
    "build-yjs": "node scripts/build-yjs.js",
    "make-icons": "node scripts/make-icons.js",
    "deploy-web": "node scripts/sync-share.js && node scripts/deploy-website.js",
    "pull-web": "node scripts/pull-website.js",
    "test:rules": "firebase emulators:exec --project inkwell-rules-test --only firestore,database \"node scripts/test-rules.js\"",
    "test:objects": "electron scripts/test-object-layers",
    "test:sanitize": "electron scripts/test-sanitize",
    "test:lists": "electron scripts/test-lists",
    "test:docx": "electron scripts/test-docx-import",
    "test:touch": "electron scripts/test-touch",
    "test:caret": "electron scripts/test-caret-geometry",
    "test:lasso": "electron scripts/test-lasso",
    "test:stift": "electron scripts/test-stift",
    "test:live": "electron scripts/test-collab-live"
  },
  "dependencies": {
    "katex": "^0.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.1",
    "firebase": "^12.17.0",
    "yjs": "^13.6.31"
  }
}
