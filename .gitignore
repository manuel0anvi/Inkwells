# ── Abhängigkeiten ──────────────────────────────────────────────────
node_modules/

# ── Zugangsdaten ────────────────────────────────────────────────────
# Enthält das Google-Client-Secret. Darf NIE ins Repo.
# Vorlage zum Kopieren: src/core/cloudConfig.local.example.js
src/core/cloudConfig.local.js

# ── Website ─────────────────────────────────────────────────────────
# Gehört auf den Branch "website", nicht hierher. Dort liegt der Inhalt
# dieses Ordners direkt im Wurzelverzeichnis, weil GitHub Pages daraus
# inkwells.me baut.
#
# Der Ordner bleibt auf dem eigenen Rechner liegen und wird von
# "npm run web" und "npm run deploy-web" weiter gebraucht. Wer den
# app-Branch frisch klont, holt ihn sich aus dem website-Branch:
#     git clone -b website https://github.com/manuel0anvi/Inkwells.git website
# Bewusst "/website/*" und nicht "/website/": in einen ausgeschlossenen
# ORDNER steigt Git gar nicht erst hinein, ein "!" darin bliebe wirkungslos.
# Mit dem Stern wird jeder Eintrag einzeln ausgeschlossen – und nur dann
# lassen sich die zwei Regeldateien darunter wieder hereinholen.
/website/*

# ── Ausnahme: die Sicherheitsregeln ──────────────────────────────────
# Sie gehören NICHT auf den website-Branch (deploy-web überspringt sie,
# siehe scripts/deploy-website.js) – lagen dadurch aber auf gar keinem
# Branch und nur örtlich auf je einem Rechner. Ausgerechnet die Dateien,
# die die Freigaben absichern, konnten so unbemerkt auseinanderlaufen:
# der eine hätte mit der echten UID veröffentlicht, der andere mit dem
# Platzhalter, und niemand hätte es gemerkt.
#
# Sie enthalten kein Geheimnis: die Admin-UID ist öffentlich, geschützt
# wird über das Passwort beim Anmelden.
!/website/firestore.rules
!/website/database.rules.json

# ── Erzeugte Ordner ─────────────────────────────────────────────────
# Arbeitsplatz von scripts/deploy-website.js (Klon des website-Branch)
.deploy-website/
.deploy-website-alt/

# Build-Ausgabe von electron-builder
dist/
release/

# ── Firebase ────────────────────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log

# ── Betriebssystem / Editor ─────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
*.swp

# ── Nicht ins Repo ──────────────────────────────────────────────────
# Beides lag eingecheckt herum und gehoert nicht dazu: das Zip ist eine
# Sicherungskopie (2,8 MB), das Symbol eine abgeloeste Fassung. Die
# Dateien bleiben oertlich liegen, nur Git fasst sie nicht mehr an.
#
# Aus der HISTORIE sind sie damit nicht weg - dafuer muesste man sie
# umschreiben, und das ist auf einem gemeinsamen Branch tabu.
final version.zip
icon-notizbuch-alt.ico

# ── Werbebilder ─────────────────────────────────────────────────────
# Die Aufnahmen entstehen aus scripts/werbebilder neu. Sie gehoeren
# nicht ins Repo: es ist oeffentlich, und die Dateien sind gross.
/werbebilder/
/werbefilm/
